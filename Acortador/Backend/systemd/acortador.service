[Unit]
Description=Servicio FastAPI Acortador de Enlaces
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Acortador_Links/Acortador/Backend
EnvironmentFile=/home/ubuntu/Acortador_Links/Acortador/Backend/.env
ExecStart=/home/ubuntu/Acortador_Links/Acortador/Backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
