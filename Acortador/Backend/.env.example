# ============================================================
# CONFIGURACIÓN DEL ACORTADOR DE ENLACES (FastAPI + DynamoDB)
# ============================================================

# Región de AWS donde reside la tabla de DynamoDB
AWS_REGION=us-east-1

# Nombre de la tabla en Amazon DynamoDB
# Partition Key esperada: short_code (String)
DYNAMODB_TABLE_NAME=shortened-urls

# URL base pública del backend para construir los enlaces cortos
# En EC2 reemplace con su IP pública o DNS: http://<ip-publica-ec2>:8000
# Si se deja vacío o no se define, se autodetecta según la petición entrante
BASE_URL=http://localhost:8000

# Orígenes permitidos para CORS (separados por coma o '*' para permitir todos)
# En producción con S3 configure: http://<nombre-bucket>.s3-website-<region>.amazonaws.com
ALLOWED_ORIGINS=*

# Modo depuración (true o false)
DEBUG=false

# ------------------------------------------------------------
# Parámetros Opcionales para Desarrollo Local
# (NO necesarios en EC2, la instancia usa el IAM Role automáticamente)
# ------------------------------------------------------------
# DYNAMODB_ENDPOINT_URL=http://localhost:8000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
